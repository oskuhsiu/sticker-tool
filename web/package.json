{
  "name": "sticker-tool-web",
  "private": true,
  "version": "0.1.0",
  "description": "sticker-tool 的純靜態網頁版（GitHub Pages 可部署）：瀏覽器內去背/切格/fit/疊字/APNG/打包",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:background-removal && npm run test:foreground-correction && npm run test:video-correction && npm run test:output-safety && npm run test:local-birefnet && npm run test:colab && npm run test:video",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test:colab": "tsx --tsconfig tsconfig.json scripts/colab-birefnet-contract.mts && tsx --tsconfig tsconfig.json scripts/colab-video-invalidation-contract.mts",
    "test:background-removal": "tsx --tsconfig tsconfig.json scripts/background-removal-contract.mts",
    "test:foreground-correction": "tsx --tsconfig tsconfig.json scripts/foreground-correction-contract.mts",
    "test:video-correction": "tsx --tsconfig tsconfig.json scripts/video-correction-contract.mts",
    "test:output-safety": "tsx --tsconfig tsconfig.json scripts/output-safety-contract.mts",
    "test:local-birefnet": "tsx --tsconfig tsconfig.json scripts/local-birefnet-contract.mts",
    "test:video": "tsx --tsconfig tsconfig.json scripts/video-project-roundtrip.mts",
    "test:video-spike": "tsx --tsconfig tsconfig.json scripts/video-all-frames-spike.mts",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:emoji": "node scripts/emoji-smoke.mjs",
    "smoke:local-birefnet": "node scripts/local-birefnet-browser-smoke.mjs",
    "smoke:video": "node scripts/video-smoke.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@imgly/background-removal": "1.4.5",
    "fflate": "^0.8.2",
    "mediabunny": "1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@imgly/background-removal-data": "^1.4.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.60.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-static-copy": "^1.0.6"
  }
}
